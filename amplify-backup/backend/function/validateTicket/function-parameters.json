        "Query",
        "Mutation"
      ]
    },
    "storage": {
      "Ticket:@model(appsync)": [
        "read",
        "update"
      ],
      "Event:@model(appsync)": [
        "read"
      ],
      "TicketCategory:@model(appsync)": [
        "read",
        "update"
      ]
    }
  },
  "lambdaLayers": [
    {
      "type": "ProjectLayer",
      "resourceName": "passinodeModules",
      "env": "devel",
      "version": "Always choose latest version",
      "isLatestVersionSelected": true
    }
  ]
}